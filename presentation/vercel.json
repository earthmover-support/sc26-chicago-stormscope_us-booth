{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "if [ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && [ \"$VERCEL_GIT_PREVIOUS_SHA\" != \"$VERCEL_GIT_COMMIT_SHA\" ] && git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA\"^{commit} 2>/dev/null && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- .; then exit 0; else exit 1; fi",
  "installCommand": "npm ci",
  "buildCommand": "npm run vendor",
  "outputDirectory": "web",
  "functions": {
    "api/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,web/**,server.py}"
    },
    "api/tiles.js": {
      "regions": [
        "iad1"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/tiles/:path*",
      "destination": "/api/tiles?path=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
